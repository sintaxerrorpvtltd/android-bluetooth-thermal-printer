<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="local.sintax.thermal58" android:versionCode="2" android:versionName="0.1.0">
 <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="36"/>
 <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation"/>
 <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
 <uses-feature android:name="android.hardware.bluetooth_le" android:required="true"/>
 <application android:label="58mm Receipt Printer" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false" android:supportsRtl="true">
  <activity android:name=".SetupActivity" android:exported="true">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
  </activity>
  <service android:name=".ReceiptService" android:label="58mm Receipt Printer" android:permission="android.permission.BIND_PRINT_SERVICE" android:exported="true">
   <intent-filter><action android:name="android.printservice.PrintService"/></intent-filter>
   <meta-data android:name="android.printservice" android:resource="@xml/printservice"/>
  </service>
 </application>
</manifest>
